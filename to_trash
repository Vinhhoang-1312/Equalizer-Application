@app.route('/generate_noise', methods=['POST'])
def generate_noise():
    """Generate noise and add to clean audio"""
    try:
        if 'file' not in request.files:
            return jsonify({'success': False, 'error': 'No file uploaded'})
        
        file = request.files['file']
        if file.filename == '':
            return jsonify({'success': False, 'error': 'No file selected'})
        
        noise_type = request.form.get('noise_type', 'white')
        noise_level = float(request.form.get('noise_level', 0.3))
        
        # Save uploaded file
        filename = secure_filename(file.filename)
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
        file.save(filepath)
        
        # Load audio
        audio, sr = librosa.load(filepath, sr=audio_processor.sample_rate)
        
        # Generate noise based on type
        if noise_type == 'white':
            noise = np.random.normal(0, 0.1, len(audio))
        elif noise_type == 'pink':
            # Pink noise approximation
            noise = np.random.normal(0, 1, len(audio))
            noise = np.convolve(noise, np.ones(100)/100, mode='same')
        elif noise_type == 'brown':
            # Brown noise with memory optimization
            n_points = min(10000, len(audio))
            brown_noise = np.cumsum(np.random.normal(0, 0.01, n_points))
            noise = np.interp(np.arange(len(audio)), np.linspace(0, len(audio)-1, n_points), brown_noise)
        else:  # gaussian
            noise = np.random.normal(0, 0.05, len(audio))
        
        # Add noise to audio
        noisy_audio = audio + noise * noise_level
        
        # Normalize to prevent clipping
        noisy_audio = noisy_audio / np.max(np.abs(noisy_audio))
        
        # Save processed file
        name_without_ext = os.path.splitext(filename)[0]
        processed_filename = f"{name_without_ext}_noisy_{noise_type}_{noise_level}.wav"
        processed_filepath = os.path.join(app.config['UPLOAD_FOLDER'], processed_filename)
        
        sf.write(processed_filepath, noisy_audio, audio_processor.sample_rate)
        
        # Create audio player HTML
        audio_player = f'''
        <div class="row">
            <div class="col-md-6">
                <h6>Original Audio:</h6>
                <audio controls class="w-100">
                    <source src="/uploads/{filename}" type="audio/wav">
                </audio>
            </div>
            <div class="col-md-6">
                <h6>Noisy Audio:</h6>
                <audio controls class="w-100">
                    <source src="/uploads/{processed_filename}" type="audio/wav">
                </audio>
            </div>
        </div>
        '''
        
        return jsonify({
            'success': True,
            'original_filename': filename,
            'processed_file': processed_filename,
            'noise_type': noise_type.title(),
            'noise_level': noise_level,
            'audio_player': audio_player
        })
        
    except Exception as e:
        print(f"Error generating noise: {e}")
        return jsonify({'success': False, 'error': str(e)})

