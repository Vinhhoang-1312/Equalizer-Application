@app.route('/upload', methods=['POST'])
def upload_file():
    """Handle file upload and processing"""
    if 'file' not in request.files:
        return jsonify({'error': 'No file provided'}), 400
    
    file = request.files['file']
    if file.filename == '':
        return jsonify({'error': 'No file selected'}), 400
    
    if file and allowed_file(file.filename):
        # Save uploaded file
        filename = secure_filename(file.filename)
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
        file.save(filepath)

        # Get processing parameters
        equalizer_params = {
            'bass_gain': float(request.form.get('bass_gain', 1.0)),
            'mid_gain': float(request.form.get('mid_gain', 1.0)),
            'treble_gain': float(request.form.get('treble_gain', 1.0)),
            'sub_bass_gain': float(request.form.get('sub_bass_gain', 1.0)),
            'presence_gain': float(request.form.get('presence_gain', 1.0)),
            'air_gain': float(request.form.get('air_gain', 1.0))
        }

        denoise_method = request.form.get('denoise_method', 'noisereduce')
        # NEW: Get recognition method (not library anymore)
        recognition_method = request.form.get('recognition_method', 'ml')

        print(f"[DEBUG] Recognition method selected: {recognition_method}")

        try:
            print(f"Web app - Starting audio processing for {filepath}")
            
            # Load audio for processing
            import librosa
            audio, sr = librosa.load(filepath, sr=audio_processor.sample_rate)
            
            # Apply equalizer
            processed_audio = audio_processor.advanced_equalizer(audio, **equalizer_params)
            
            # Apply noise reduction  
            denoised_audio = audio_processor.advanced_noise_reduction(processed_audio, denoise_method)
            
            # Genre classification using selected method
            if recognition_method == 'ml':
                genre, confidence, genre_details = genre_recognizer.method_1_machine_learning(denoised_audio, audio_processor)
            elif recognition_method == 'signal':
                genre, confidence, genre_details = genre_recognizer.method_2_signal_processing(denoised_audio)
            elif recognition_method == 'frequency':
                genre, confidence, genre_details = genre_recognizer.method_3_frequency_analysis(denoised_audio)
            elif recognition_method == 'rhythm':
                genre, confidence, genre_details = genre_recognizer.method_4_rhythm_pattern(denoised_audio)
            else:
                # Default fallback
                genre, confidence, genre_details = genre_recognizer.method_2_signal_processing(denoised_audio)
            
            print(f"Web app - Genre classification completed: {genre} ({confidence:.1%})")
            
            # Prepare results
            results = {
                'processed_audio': denoised_audio,
                'genre': genre,
                'confidence': f"{confidence:.1%}",
                'analysis': genre_details,
                'equalizer_params': equalizer_params,
                'denoise_method': denoise_method,
                'recognition_method': recognition_method,
                'all_probabilities': genre_details.get('all_probabilities', {})
            }
            print(f"Web app - Audio processing completed")

            # Save processed audio
            output_filename = f"processed_{filename}"
            output_path = os.path.join(BASE_DIR, 'static', 'results', output_filename)
            audio_processor.save_audio(results['processed_audio'], output_path)

            # Create waveform + spectrogram visualization
            viz_filename = f"analysis_{filename.rsplit('.', 1)[0]}.png"
            viz_path = os.path.join(BASE_DIR, 'static', 'results', viz_filename)
            try:
                plt.clf()
                plt.close('all')
                fig, axs = plt.subplots(2, 1, figsize=(12, 8))
                # Waveform
                axs[0].plot(np.linspace(0, len(audio)/sr, len(audio)), audio, color='blue')
                axs[0].set_title('Waveform')
                axs[0].set_xlabel('Time (s)')
                axs[0].set_ylabel('Amplitude')
                # Spectrogram
                S = librosa.feature.melspectrogram(y=audio, sr=sr, n_mels=128)
                S_dB = librosa.power_to_db(S, ref=np.max)
                img = librosa.display.specshow(S_dB, x_axis='time', y_axis='mel', sr=sr, ax=axs[1], cmap='magma')
                axs[1].set_title('Mel Spectrogram')
                fig.colorbar(img, ax=axs[1], format='%+2.0f dB')
                plt.tight_layout()
                plt.savefig(viz_path, dpi=150, bbox_inches='tight')
                plt.close(fig)
                plt.close('all')
                print(f"📊 Visualization created: {viz_path}")
            except Exception as viz_error:
                print(f"❌ Visualization failed: {viz_error}")
                viz_filename = None

            # Prepare response with audio URLs for direct playback
            response_data = {
                'success': True,
                'original_file': filename,
                'original_url': f'/uploads/{filename}',  # Direct path for audio player
                'processed_file': output_filename,
                'processed_url': f'/static/results/{output_filename}',  # Direct path for audio player
                'analysis_chart': f'/static/results/{viz_filename}' if viz_filename else None,
                'genre': results['genre'],
                'confidence': results['confidence'],
                'method_used': recognition_method,
                'analysis': results['analysis'],
                'all_probabilities': results['all_probabilities']
            }

            return jsonify(response_data)

        except Exception as e:
            return jsonify({'error': f'Processing failed: {str(e)}'}), 500

    return jsonify({'error': 'Invalid file type'}), 400

